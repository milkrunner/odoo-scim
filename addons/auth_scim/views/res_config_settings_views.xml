<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auth.scim</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="module_auth_ldap" position="after">
                <setting string="SCIM 2.0 Provisioning"
                         help="Enable automated user provisioning from Microsoft Entra ID via SCIM 2.0"
                         id="scim_provisioning_setting">
                    <field name="scim_enabled"/>
                    <div class="content-group" invisible="not scim_enabled">
                        <div class="row mt16">
                            <label for="scim_base_url" string="Tenant URL:" class="col-lg-3 o_light_label"/>
                            <field name="scim_base_url" readonly="1" widget="CopyClipboardChar"/>
                        </div>
                        <div class="mt8">
                            <button type="action"
                                    name="%(auth_scim.action_scim_token)d"
                                    string="SCIM Tokens"
                                    icon="oi-arrow-right"
                                    class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

    <!-- SCIM Token tree view -->
    <record id="view_scim_token_tree" model="ir.ui.view">
        <field name="name">auth.scim.token.tree</field>
        <field name="model">auth.scim.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="token" password="True" groups="base.group_system"/>
                <field name="active"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- SCIM Token form view -->
    <record id="view_scim_token_form" model="ir.ui.view">
        <field name="name">auth.scim.token.form</field>
        <field name="model">auth.scim.token</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="token" widget="CopyClipboardChar" groups="base.group_system"/>
                        <field name="active"/>
                        <field name="create_date"/>
                    </group>
                    <footer>
                        <button name="action_regenerate_token" string="Regenerate Token"
                                type="object" class="btn-secondary" confirm="This will invalidate the current token. Continue?"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SCIM Token action -->
    <record id="action_scim_token" model="ir.actions.act_window">
        <field name="name">SCIM Tokens</field>
        <field name="res_model">auth.scim.token</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
